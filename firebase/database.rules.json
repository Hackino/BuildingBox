{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('role').val() === 'viewer') || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['role']) && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'viewer')",
        "role": { ".validate": "newData.isString()" },
        "displayName": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "building": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "currentMonth": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)" }
    },

    "apartments": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$aptId": {
        ".validate": "newData.hasChildren(['name','ownerName','floor'])",
        "name":        { ".validate": "newData.isString()" },
        "ownerName":   { ".validate": "newData.isString()" },
        "floor":       { ".validate": "newData.isNumber()" },
        "feeUsdCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "feeLbp":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "phone":       { ".validate": "newData.isString()" },
        "active":      { ".validate": "newData.isBoolean()" },
        "createdAt":   { ".validate": "newData.isNumber()" }
      }
    },

    "dues": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$month": {
        ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
        "$aptId": {
          "$dueId": {
            ".validate": "newData.hasChildren(['title','paid'])",
            "title":    { ".validate": "newData.isString()" },
            "usdCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "lbp":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "paid":     { ".validate": "newData.isBoolean()" },
            "paidOn":   { ".validate": "newData.isString()" },
            "base":     { ".validate": "newData.isBoolean()" }
          }
        }
      }
    },

    "expenses": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$month": {
        ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
        "$expenseId": {
          ".validate": "newData.hasChildren(['label','date'])",
          "date":     { ".validate": "newData.isString()" },
          "label":    { ".validate": "newData.isString()" },
          "category": { ".validate": "newData.isString()" },
          "usdCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "lbp":      { ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      }
    },

    "summaries": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "state": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
