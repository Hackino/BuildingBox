# Copy this file to keystore.properties and fill in the real values.
# keystore.properties is git-ignored and must never be committed.
#
# storeFile is resolved relative to the composeApp module directory.
# Generate a keystore with:
#   keytool -genkeypair -keystore composeApp/buildingbox.keystore \
#     -alias buildingbox -keyalg RSA -keysize 2048 -validity 10000

storeFile=buildingbox.keystore
storePassword=CHANGE_ME
keyAlias=buildingbox
keyPassword=CHANGE_ME
