# ============================================================
#  Gradle / build
# ============================================================
.gradle/
build/
**/build/
.kotlin/
local.properties

# ============================================================
#  SECRETS — never commit. These repos may be public.
#  In CI, these files are recreated from GitHub Actions secrets.
# ============================================================

# Firebase (per-client, different for each buyer)
**/google-services.json
**/GoogleService-Info.plist
**/desktop-firebase.properties

# Signing (keystore can be shared; the file + passwords stay secret)
keystore.properties
**/keystore.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.jks.b64
**/*.keystore.b64

# Env / misc secrets
.env
.env.*
*.pem
secrets/
*.secrets.properties

# ============================================================
#  IDE / OS
# ============================================================
.idea/
*.iml
.DS_Store

# Xcode
xcuserdata/
*.xcworkspace/xcuserdata/

# ============================================================
#  Packaged apps / build artifacts — NEVER COMMIT
#  Most land under build/ (ignored above); these patterns also
#  block a binary copied anywhere else (e.g. the repo root).
# ============================================================

# Android
*.apk
*.aab
*.apks
*.aar

# iOS
*.ipa
*.xcarchive

# Desktop installers / distributables (jpackage output)
*.msi
*.exe
*.dmg
*.pkg
*.deb
*.rpm
*.app

# Runnable JVM bundles
*-uber.jar
*.jar.uber
